# Stripe is required to sell a billboard: without STRIPE_SECRET_KEY the claim
# form answers "payments are not configured" and nothing is ever planted.
# Without Supabase the highway simply shows the seed ranking.

# Supabase (DB + realtime). See supabase/schema.sql
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=

# Stripe Checkout
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# Absolute URL of the deployed site (for Stripe redirect URLs)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shared secret that authorizes opengraph-image.tsx's internal, server-side
# fetch of /og-render in production (see app/og-render/page.tsx). Without it,
# /og-render 404s for everyone in production — including the OG image itself,
# which then falls back to a plain text card. Any long random string works;
# set the same value here as on the deployment (Vercel env vars).
OG_RENDER_SECRET=
